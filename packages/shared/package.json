{
  "name": "@one-link/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared, dependency-free logic: platform rules, caption adaptation, hashtag scoring, curated trends, templates, plans. The /node entry adds the token vault.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
