{
  "name": "one-link",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One Link — Create once. Reach everywhere.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install",
    "build:all": "npm run build --workspaces --if-present",
    "build:web": "npm --workspace apps/web run build",
    "android:build": "npm --workspace apps/web run android:build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps"
  },
  "engines": {
    "node": ">=22"
  }
}
