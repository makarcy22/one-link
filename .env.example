# Copy this file to .env for local development:
#   Copy-Item .env.example .env
# Never commit .env to Git. Production values come from the hosting provider's secret store.

# PostgreSQL (local Docker)
DATABASE_URL=postgresql://onelink:onelink@localhost:5432/onelink

# Redis (local Docker)
REDIS_URL=redis://localhost:6379

# Better Auth — generate a fresh secret per environment (at least 32 characters).
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
BETTER_AUTH_SECRET=WuQe/yvlGN0GeQAthroW8pZ3M2I+sRJ9UkVe4vZCL3Y=
BETTER_AUTH_URL=http://localhost:3000

# Web app origin (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Google social login (optional for now; required to enable the Google button)
# Create credentials at Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (SMTP). Leave blank for console-only dev mode.
# Option A — Gmail: host smtp.gmail.com, port 587, user your@gmail.com,
# pass = Google App Password (Account → Security → 2-Step Verification → App passwords).
# Option B — Mailtrap: copy host/port/user/pass from your Mailtrap inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=One Link <noreply@localhost>

# Local file storage root (development only)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Production storage (Cloudflare R2, S3-compatible). Leave unset for local dev.
# R2 dashboard (dash.cloudflare.com → R2) → bucket → Manage API tokens →
# create a token with Object Read & Write. Paste values ONLY into real .env files.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=one-link-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://<your-public-bucket-url>

# Billing (Paystack). Test mode first: dashboard.paystack.com → Settings → API Keys.
# Create plans (Creator monthly, Business monthly) → copy their plan codes here.
# Webhook URL to register: https://<your-api-domain>/api/billing/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CREATOR=
PAYSTACK_PLAN_BUSINESS=

# Social publishing connectors (all optional until configured).
# Generate SOCIAL_TOKEN_KEY: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Redirect URIs to register (local dev):
#   http://localhost:3000/api/social/tiktok/callback
#   http://localhost:3000/api/social/facebook/callback
#   http://localhost:3000/api/social/instagram/callback
#   http://localhost:3000/api/social/linkedin/callback
#   http://localhost:3000/api/social/whatsappstatus/callback
SOCIAL_TOKEN_KEY=
TIKTOK_CLIENT_KEY=aw981qcvll1cw99i
TIKTOK_CLIENT_SECRET=QoG3J3ck2V1nCVYVvkOYkuf165Fa7lMf
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Real AI provider (Groq). Leave blank to keep the built-in template engine.
# Get a key: console.groq.com → API Keys → Create. Paste it ONLY into your
# local .env as GROQ_API_KEY (never chat, never GitHub). Model IDs change
# often — check the Groq console for a current chat model and set GROQ_MODEL.
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile


Host
live.smtp.mailtrap.io

Port
587 (recommended), 465, 2525 or 25

Username
api
smtp@mailtrap.io

Password
<YOUR_API_TOKEN>

Auth
PLAIN, LOGIN

TLS
Required. STARTTLS on ports 587, 2525 and 25. Forced TLS on port 465.